<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FTR" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ftr_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.FTR.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ftr_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FTR</item>
    </style>
    <color name="ftr_bg">#FFFBF3</color>
</resources>
